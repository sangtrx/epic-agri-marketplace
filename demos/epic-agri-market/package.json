{
  "name": "epic-agri-market",
  "private": true,
  "scripts": {
    "build": "bun run --cwd apps/admin build && bun run --cwd apps/vendor build && bun run --cwd packages/api build && bun run --cwd apps/storefront build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "demo:configure": "node scripts/configure-demo.mjs",
    "demo:setup": "bun run --cwd packages/api demo:setup",
    "test:demo": "bun test tests/catalog.test.ts",
    "typecheck": "bun run --cwd packages/api typecheck && bun run --cwd apps/admin typecheck && bun run --cwd apps/vendor typecheck && bun run --cwd apps/storefront typecheck",
    "postinstall": "bun run --cwd packages/api codegen",
    "demo:smoke": "bun run --cwd packages/api demo:smoke"
  },
  "dependencies": {
    "react": "18.3.1",
